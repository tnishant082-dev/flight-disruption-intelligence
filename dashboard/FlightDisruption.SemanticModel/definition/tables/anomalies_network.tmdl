	partition anomalies_network = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DataFolder & "\anomalies_network.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Promoted = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes ( Promoted, {{"flight_date", type date}, {"scheduled_flights", Int64.Type}, {"arr_delay_rate", type number}, {"cancellation_rate", type number}, {"avg_arr_delay_min", type number}, {"weather_delay_min", type number}, {"nas_delay_min", type number}, {"carrier_delay_min", type number}, {"late_aircraft_delay_min", type number}, {"arr_delay_rate_trend", type number}, {"arr_delay_rate_resid", type number}, {"arr_delay_rate_z", type number}, {"cancellation_rate_trend", type number}, {"cancellation_rate_resid", type number}, {"cancellation_rate_z", type number}, {"is_anomaly", Int64.Type}, {"anomaly_driver", type text}} )
				in
				    Typed
