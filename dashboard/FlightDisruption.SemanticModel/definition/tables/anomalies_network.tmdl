/// Daily network series with STL residual z-scores and flags
table anomalies_network
	lineageTag: dce6df38-196e-538f-ba35-79427d24f8a8

	column flight_date
		dataType: dateTime
		lineageTag: c65ecddb-b719-5720-a559-e6dac5c4f60f
		summarizeBy: none
		sourceColumn: flight_date

		annotation SummarizationSetBy = Automatic

	column scheduled_flights
		dataType: int64
		formatString: 0
		lineageTag: f67d2eed-c11f-52b1-9463-3c81fa37895d
		summarizeBy: none
		sourceColumn: scheduled_flights

		annotation SummarizationSetBy = Automatic

	column arr_delay_rate
		dataType: double
		lineageTag: 51584eac-db2e-505c-b4d3-8edc9a71581e
		summarizeBy: sum
		sourceColumn: arr_delay_rate

		annotation SummarizationSetBy = Automatic

	column cancellation_rate
